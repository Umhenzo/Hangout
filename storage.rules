rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /profilePhotos/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /globalPhotos/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /chatPhotos/{chatId}/{userId}/{fileName} {
      function memberOfChat() {
        return request.auth != null
          && firestore.exists(/databases/(default)/documents/privateChats/$(chatId))
          && firestore.get(/databases/(default)/documents/privateChats/$(chatId)).data.members.hasAny([request.auth.uid]);
      }

      allow read: if memberOfChat();
      allow write: if memberOfChat()
        && request.auth.uid == userId
        && request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}