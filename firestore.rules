rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUsername(username) {
      return signedIn()
        && username is string
        && username.matches('^[a-z0-9_.]{3,20}$')
        && request.auth.token.email == username + '@users.hangout.invalid';
    }

    function validPhoto(value) {
      return value is string
        && value.size() <= 700000
        && (
          value.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
          || value.matches('^https://firebasestorage\\.googleapis\\.com/.*$')
        );
    }

    function validProfileData(data, userId) {
      return data.uid == userId
        && ownsUsername(data.username)
        && data.keys().hasOnly([
          'uid', 'username', 'createdAt', 'photoUrl', 'status', 'country',
          'isOnline', 'lastSeen'
        ])
        && (!('photoUrl' in data) || validPhoto(data.photoUrl))
        && (!('status' in data) || (data.status is string && data.status.size() <= 60))
        && (!('country' in data) || (data.country is string && data.country.size() <= 80))
        && (!('isOnline' in data) || data.isOnline is bool);
    }

    function isPrivateChatMember(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/privateChats/$(chatId))
        && get(/databases/$(database)/documents/privateChats/$(chatId)).data.members.hasAny([request.auth.uid]);
    }

    function validImageUrl(data) {
      return 'imageUrl' in data
        && data.imageUrl is string
        && data.imageUrl.size() <= 700000
        && (
          data.imageUrl.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')
          || data.imageUrl.matches('^https://firebasestorage\\.googleapis\\.com/.*$')
        );
    }

    function validAudio(data) {
      return 'audioData' in data
        && data.audioData is string
        && data.audioData.size() <= 700000
        && data.audioData.matches('^[A-Za-z0-9+/=]+$');
    }

    match /profiles/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId
        && validProfileData(request.resource.data, userId);
      allow update: if signedIn() && request.auth.uid == userId
        && validProfileData(request.resource.data, userId);
      allow delete: if false;
    }

    match /globalMessages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && (
          request.resource.data.text.size() > 0
          || validImageUrl(request.resource.data)
          || validAudio(request.resource.data)
        )
        && (!('imageUrl' in request.resource.data) || validImageUrl(request.resource.data))
        && (!('audioData' in request.resource.data) || validAudio(request.resource.data))
        && request.resource.data.keys().hasOnly(['text', 'imageUrl', 'audioData', 'uid', 'email', 'createdAt']);
      allow update, delete: if false;
    }

    match /privateChats/{chatId} {
      allow read: if signedIn()
        && (!exists(/databases/$(database)/documents/privateChats/$(chatId))
          || resource.data.members.hasAny([request.auth.uid]));

      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] != request.resource.data.members[1]
        && request.resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 200
        && request.resource.data.lastSenderUid is string
        && request.resource.data.keys().hasOnly([
          'members', 'createdAt', 'updatedAt', 'lastMessage', 'lastSenderUid'
        ]);

      allow update: if signedIn()
        && resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastSenderUid', 'updatedAt'])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 200
        && request.resource.data.lastSenderUid == request.auth.uid;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isPrivateChatMember(chatId);
        allow create: if isPrivateChatMember(chatId)
          && request.resource.data.senderUid == request.auth.uid
          && ownsUsername(request.resource.data.senderUsername)
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (
            request.resource.data.text.size() > 0
            || validImageUrl(request.resource.data)
            || validAudio(request.resource.data)
          )
          && (!('imageUrl' in request.resource.data) || validImageUrl(request.resource.data))
          && (!('audioData' in request.resource.data) || validAudio(request.resource.data))
          && request.resource.data.keys().hasOnly([
            'text', 'imageUrl', 'audioData', 'senderUid', 'senderUsername', 'createdAt'
          ]);
        allow update, delete: if false;
      }

      match /calls/{callId} {
        allow read: if callId == 'active' && isPrivateChatMember(chatId);

        allow create: if callId == 'active'
          && isPrivateChatMember(chatId)
          && request.resource.data.keys().hasOnly([
            'callerUid', 'calleeUid', 'status', 'roomName', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.callerUid == request.auth.uid
          && request.resource.data.calleeUid is string
          && request.resource.data.calleeUid != request.auth.uid
          && get(/databases/$(database)/documents/privateChats/$(chatId)).data.members
            .hasAll([request.auth.uid, request.resource.data.calleeUid])
          && request.resource.data.status == 'ringing'
          && request.resource.data.roomName == 'direct_' + chatId;

        allow update: if callId == 'active'
          && isPrivateChatMember(chatId)
          && request.resource.data.keys().hasOnly([
            'callerUid', 'calleeUid', 'status', 'roomName', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.callerUid is string
          && request.resource.data.calleeUid is string
          && request.resource.data.calleeUid != request.resource.data.callerUid
          && get(/databases/$(database)/documents/privateChats/$(chatId)).data.members
            .hasAll([request.resource.data.callerUid, request.resource.data.calleeUid])
          && request.resource.data.roomName == 'direct_' + chatId
          && (
            (
              resource.data.status == 'ringing'
              && (
                (request.auth.uid == resource.data.calleeUid
                  && request.resource.data.status in ['active', 'rejected'])
                || (request.auth.uid == resource.data.callerUid
                  && request.resource.data.status == 'ended')
              )
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'updatedAt'])
            )
            || (
              resource.data.status == 'active'
              && request.auth.uid in [resource.data.callerUid, resource.data.calleeUid]
              && request.resource.data.status == 'ended'
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'updatedAt'])
            )
            || (
              resource.data.status in ['ended', 'rejected']
              && request.resource.data.status == 'ringing'
              && request.resource.data.callerUid == request.auth.uid
              && request.resource.data.calleeUid != request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'callerUid', 'calleeUid', 'status', 'roomName', 'createdAt', 'updatedAt'
                ])
            )
          );

        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}