rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUsername(username) {
      return signedIn()
        && username is string
        && username.matches('^[a-z0-9_.]{3,20}$')
        && request.auth.token.email == username + '@users.hangout.invalid';
    }

    function isPrivateChatMember(chatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/privateChats/$(chatId))
        && get(/databases/$(database)/documents/privateChats/$(chatId)).data.members.hasAny([request.auth.uid]);
    }

    match /profiles/{userId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && ownsUsername(request.resource.data.username)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt']);

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && ownsUsername(request.resource.data.username)
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt']);

      allow delete: if false;
    }

    match /globalMessages/{messageId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.keys().hasOnly(['text', 'uid', 'email', 'createdAt']);

      allow update, delete: if false;
    }

    match /privateChats/{chatId} {
      allow read: if signedIn() && resource.data.members.hasAny([request.auth.uid]);

      allow create: if signedIn()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] != request.resource.data.members[1]
        && request.resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 200
        && request.resource.data.lastSenderUid is string
        && request.resource.data.keys().hasOnly([
          'members', 'createdAt', 'updatedAt', 'lastMessage', 'lastSenderUid'
        ]);

      allow update: if signedIn()
        && resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastSenderUid', 'updatedAt'])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 200
        && request.resource.data.lastSenderUid == request.auth.uid;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isPrivateChatMember(chatId);

        allow create: if isPrivateChatMember(chatId)
          && request.resource.data.senderUid == request.auth.uid
          && ownsUsername(request.resource.data.senderUsername)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.keys().hasOnly([
            'text', 'senderUid', 'senderUsername', 'createdAt'
          ]);

        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}